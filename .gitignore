# --- Python bytecode & caches ---
__pycache__/
*.py[co]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Build & packaging output ---
# Binaries (EXE, installer, portable zip) are release artifacts: they are
# published to GitHub Releases, not committed. Only the small text manifest
# and checksums under release_assets/ are tracked so downloads can be verified.
build/
dist/
build_*/
dist_*/
*.exe
*.zip
*.egg-info/

# --- Virtual environments ---
.venv/
venv/
test_venv/

# --- Logs ---
logs/
*.log

# --- Coverage reports ---
coverage.xml
.coverage
htmlcov/

# --- Generated benchmark / documentation artifacts ---
benchmark_*.json
benchmark_export.json
code_doc_*.md
code_doc_*.json
code_doc_*.html
code_doc_*.tex
code_doc_*.pdf
code_doc_*.svg

# --- Temporary / smoke-test artifacts ---
.smoke_tmp/

# --- Release staging & runtime state ---
release_ready/
mcp_*.json
release_build/
.cloudsmith_*.json
release_assets/
Release_v*/
winzip/
linuxzip/
docgen_proof/
.qector_decoder_site/

# --- SSH deploy keys ---
deploy_key.pub

# --- Build scratch that has repeatedly leaked into the tree ---
# Stderr captures from frozen-app debugging sessions
frozen_*.txt
# Sentinel files written by the .deb / onefile build scripts
build_*.done
# Generated by scripts/build_installer.py from version.py
installer_version.iss
# Accidental pip redirect artifacts (e.g. `pip install numpy >=1.24,<2.3`
# without quotes creates a file literally named "=1.24,")
=*
