FROM kalilinux/kali-rolling

# Update and install Kali desktop + VNC server
RUN apt-get update && apt-get install -y \
    kali-linux-core \
    kali-desktop-xfce \
    kali-tools-top10 \
    xvfb \
    x11vnc \
    novnc \
    supervisor \
    dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

# VNC password is REQUIRED at build time — no insecure default.
# Build with: docker build -f Dockerfile.gui --build-arg VNC_PASSWORD=<strong-password> .
ARG VNC_PASSWORD
RUN test -n "$VNC_PASSWORD" || (echo "ERROR: VNC_PASSWORD build-arg is required" && exit 1)
RUN mkdir -p /root/.vnc && \
    echo "$VNC_PASSWORD" | vncpasswd -f > /root/.vnc/passwd && \
    chmod 600 /root/.vnc/passwd && \
    unset VNC_PASSWORD

# Create supervisor config
RUN mkdir -p /etc/supervisor/conf.d
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose VNC and noVNC ports
EXPOSE 5900 6080

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]
